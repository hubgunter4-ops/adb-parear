#!/usr/bin/env bash
# Emparejamiento y conexión inalámbrica de Android con ADB en Ubuntu.
# Requiere adb; qrencode solo para el modo QR.
set -uo pipefail

VERSION="1.1.0"
TIMEOUT=120
CONNECT_TIMEOUT=15
APP_NAME="adb-parear"

if [[ -t 1 && -n "${TERM:-}" && "${TERM:-}" != "dumb" ]]; then
  C_RESET=$'\033[0m'; C_BOLD=$'\033[1m'; C_DIM=$'\033[2m'
  C_CYAN=$'\033[36m'; C_GREEN=$'\033[32m'; C_YELLOW=$'\033[33m'; C_RED=$'\033[31m'
else
  C_RESET=''; C_BOLD=''; C_DIM=''; C_CYAN=''; C_GREEN=''; C_YELLOW=''; C_RED=''
fi

info() { printf '%sℹ%s %s\n' "$C_CYAN" "$C_RESET" "$*"; }
ok() { printf '%s✓%s %s\n' "$C_GREEN" "$C_RESET" "$*"; }
warn() { printf '%s!%s %s\n' "$C_YELLOW" "$C_RESET" "$*" >&2; }
err() { printf '%sError:%s %s\n' "$C_RED" "$C_RESET" "$*" >&2; }

on_interrupt() {
  printf '\n%sCancelado.%s\n' "$C_YELLOW" "$C_RESET" >&2
  exit 130
}
trap on_interrupt INT TERM

usage() {
  cat <<EOF
$APP_NAME $VERSION — empareja y conecta Android por ADB inalámbrico.

Uso:
  $APP_NAME                 Abrir el menú interactivo
  $APP_NAME --qr            Emparejar con QR, conectar y verificar
  $APP_NAME --code          Emparejar con IP:puerto/PIN, conectar y verificar
  $APP_NAME --list          Mostrar dispositivos ADB conectados/autorizados
  $APP_NAME --timeout SEC   Cambiar el tiempo de espera del modo QR (10–900)
  $APP_NAME --help          Mostrar esta ayuda

En modo QR, el QR aparece en Ubuntu y se escanea desde el móvil:
Opciones de desarrollador > Depuración inalámbrica > Emparejar dispositivo con código QR.
Tras emparejar, el programa ejecuta adb connect y verifica el estado device.
EOF
}

check_adb() {
  if ! command -v adb >/dev/null 2>&1; then
    err "No encuentro 'adb'. En Ubuntu puedes instalarlo con: sudo apt install adb"
    return 127
  fi
  return 0
}

check_qrencode() {
  if ! command -v qrencode >/dev/null 2>&1; then
    err "No encuentro 'qrencode'. En Ubuntu puedes instalarlo con: sudo apt install qrencode"
    return 127
  fi
  return 0
}

valid_endpoint() {
  local endpoint="$1" host port
  [[ "$endpoint" =~ ^(\[[0-9A-Fa-f:.%]+\]|[A-Za-z0-9._-]+):([0-9]{1,5})$ ]] || return 1
  host="${endpoint%:*}"
  port="${endpoint##*:}"
  [[ -n "$host" ]] || return 1
  (( 10#$port >= 1 && 10#$port <= 65535 )) || return 1
  return 0
}

show_devices() {
  check_adb || return $?
  printf '\n%sDispositivos ADB%s\n' "$C_BOLD" "$C_RESET"
  if ! adb devices -l; then
    err "'adb devices -l' terminó con error. Comprueba la instalación de Platform Tools."
    return 1
  fi
  printf '\n'
}

make_pairing_code() {
  local raw
  raw="$(od -An -N4 -tu4 /dev/urandom 2>/dev/null | tr -d '[:space:]')" || return 1
  [[ "$raw" =~ ^[0-9]+$ ]] || return 1
  printf '%06d' "$((raw % 1000000))"
}

make_service_name() {
  local random_hex
  random_hex="$(od -An -N4 -tx1 /dev/urandom 2>/dev/null | tr -d '[:space:]')" || return 1
  [[ "$random_hex" =~ ^[0-9a-fA-F]{8}$ ]] || return 1
  printf 'adb-parear-%s' "${random_hex,,}"
}

find_pairing_services() {
  adb mdns services 2>/dev/null | awk '
    /_adb-tls-pairing[.]_tcp/ {
      address = $NF
      if (address ~ /:[0-9]+$/) print $1 "\t" address
    }
  ' | sort -u
}

find_connect_services() {
  adb mdns services 2>/dev/null | awk '
    /_adb-tls-connect[.]_tcp/ {
      address = $NF
      if (address ~ /:[0-9]+$/) print $1 "\t" address
    }
  ' | sort -u
}

choose_service() {
  local -n found_ref=$1
  local selection
  if ((${#found_ref[@]} == 1)); then
    SELECTED_ENDPOINT="${found_ref[0]#*$'\t'}"
    printf 'Servicio encontrado: %s (%s)\n' "${found_ref[0]%$'\t'*}" "$SELECTED_ENDPOINT"
    return 0
  fi

  printf '\n%sServicios de emparejamiento detectados:%s\n' "$C_BOLD" "$C_RESET"
  local i label address
  for i in "${!found_ref[@]}"; do
    label="${found_ref[$i]%$'\t'*}"
    address="${found_ref[$i]#*$'\t'}"
    printf '  %d) %-34s %s\n' "$((i + 1))" "$label" "$address"
  done
  while true; do
    printf 'Elige el número del móvil que escaneó el QR (o q para cancelar): '
    IFS= read -r selection || return 1
    [[ "$selection" == "q" || "$selection" == "Q" ]] && return 1
    if [[ "$selection" =~ ^[0-9]+$ ]] && (( selection >= 1 && selection <= ${#found_ref[@]} )); then
      SELECTED_ENDPOINT="${found_ref[$((selection - 1))]#*$'\t'}"
      return 0
    fi
    warn "Elige un número de la lista."
  done
}

choose_connect_service() {
  local -n found_ref=$1
  local selection
  if ((${#found_ref[@]} == 1)); then
    CONNECT_ENDPOINT="${found_ref[0]#*$'\t'}"
    printf 'Servicio de conexión encontrado: %s (%s)\n' "${found_ref[0]%$'\t'*}" "$CONNECT_ENDPOINT"
    return 0
  fi

  printf '\n%sServicios ADB de conexión detectados:%s\n' "$C_BOLD" "$C_RESET"
  local i label address
  for i in "${!found_ref[@]}"; do
    label="${found_ref[$i]%$'\t'*}"
    address="${found_ref[$i]#*$'\t'}"
    printf '  %d) %-34s %s\n' "$((i + 1))" "$label" "$address"
  done
  while true; do
    printf 'Elige el número del dispositivo que acabas de emparejar (o q para cancelar): '
    IFS= read -r selection || return 1
    [[ "$selection" == "q" || "$selection" == "Q" ]] && return 1
    if [[ "$selection" =~ ^[0-9]+$ ]] && (( selection >= 1 && selection <= ${#found_ref[@]} )); then
      CONNECT_ENDPOINT="${found_ref[$((selection - 1))]#*$'\t'}"
      return 0
    fi
    warn "Elige un número de la lista."
  done
}

connect_after_pairing() {
  local elapsed=0
  local -a services=()
  local CONNECT_ENDPOINT=''
  printf '\n'
  info "Buscando el servicio ADB de conexión por mDNS (hasta ${CONNECT_TIMEOUT}s)…"
  while (( elapsed < CONNECT_TIMEOUT )); do
    mapfile -t services < <(find_connect_services)
    if ((${#services[@]} > 0)); then
      break
    fi
    sleep 1
    ((elapsed += 1))
  done

  if ((${#services[@]} > 0)); then
    choose_connect_service services || { warn "No se seleccionó un dispositivo para conectar."; return 1; }
  else
    warn "No encontré un servicio mDNS de conexión. El puerto de conexión es distinto del puerto de emparejamiento."
    printf 'Escribe el IP:puerto que aparece en la pantalla principal de Depuración inalámbrica: '
    IFS= read -r CONNECT_ENDPOINT || return 1
    if [[ -z "$CONNECT_ENDPOINT" ]]; then
      err "Se necesita el IP:puerto de conexión para completar el proceso."
      return 1
    fi
  fi

  if ! valid_endpoint "$CONNECT_ENDPOINT"; then
    err "Dirección de conexión no válida: $CONNECT_ENDPOINT"
    return 2
  fi

  printf '\n'
  info "Conectando con adb connect ${CONNECT_ENDPOINT}…"
  if ! adb connect "$CONNECT_ENDPOINT"; then
    err "'adb connect' falló para ${CONNECT_ENDPOINT}."
    return 1
  fi

  local devices_output
  devices_output="$(adb devices -l)" || { err "No pude verificar el estado con 'adb devices -l'."; return 1; }
  printf '\n%s\n' "$devices_output"
  if awk -v serial="$CONNECT_ENDPOINT" '$1 == serial && $2 == "device" { found=1 } END { exit !found }' <<< "$devices_output"; then
    ok "ADB funcional: ${CONNECT_ENDPOINT} aparece en estado device."
    return 0
  fi
  err "ADB no confirmó ${CONNECT_ENDPOINT} en estado device. Revisa la pantalla de Depuración inalámbrica del teléfono."
  return 1
}

pair_qr() {
  check_adb || return $?
  check_qrencode || return $?
  if [[ ! "$TIMEOUT" =~ ^[0-9]+$ ]] || (( TIMEOUT < 10 || TIMEOUT > 900 )); then
    err "El tiempo de espera debe ser un número entre 10 y 900 segundos."
    return 2
  fi

  local name code payload elapsed stable
  name="$(make_service_name)" || { err "No pude generar el identificador QR."; return 1; }
  code="$(make_pairing_code)" || { err "No pude generar el código temporal."; return 1; }
  payload="WIFI:T:ADB;S:${name};P:${code};;"

  printf '\n%sEmparejar por QR%s\n' "$C_BOLD" "$C_RESET"
  info "En el teléfono abre Opciones de desarrollador > Depuración inalámbrica."
  info "Pulsa 'Emparejar dispositivo con código QR' y escanea el QR de abajo."
  info "El teléfono y este Ubuntu deben estar en la misma red Wi-Fi."
  printf '\n'
  if ! qrencode -m 2 -t ANSIUTF8 "$payload"; then
    err "No se pudo dibujar el QR en esta terminal. Prueba desde un terminal compatible con UTF-8."
    return 1
  fi
  printf '\n'
  warn "Esperando el servicio mDNS hasta ${TIMEOUT}s. Ctrl+C cancela."
  local -a services=()
  elapsed=0
  stable=0
  while (( elapsed < TIMEOUT )); do
    mapfile -t services < <(find_pairing_services)
    if ((${#services[@]} > 0)); then
      ((stable += 1))
      # Deja un momento para que aparezcan otros móviles en modo de emparejamiento.
      (( stable >= 2 )) && break
    else
      stable=0
    fi
    sleep 1
    ((elapsed += 1))
  done

  if ((${#services[@]} == 0)); then
    err "No apareció ningún servicio de emparejamiento. Revisa que el teléfono haya escaneado el QR y que mDNS no esté bloqueado por la red."
    warn "Las redes de invitados pueden aislar los dispositivos. Prueba una red privada compartida o el modo de código manual."
    return 1
  fi

  local SELECTED_ENDPOINT=''
  choose_service services || { warn "No se seleccionó un dispositivo."; return 1; }
  if ! valid_endpoint "$SELECTED_ENDPOINT"; then
    err "ADB devolvió una dirección no válida: $SELECTED_ENDPOINT"
    return 1
  fi

  printf '\n'
  info "Emparejando con ${SELECTED_ENDPOINT}…"
  if ! adb pair "$SELECTED_ENDPOINT" "$code"; then
    err "ADB no pudo emparejar el dispositivo. Verifica que el QR siga activo y vuelve a intentarlo."
    return 1
  fi
  ok "Emparejamiento completado."
  connect_after_pairing
}

pair_code() {
  check_adb || return $?
  local endpoint
  printf 'Dirección IP:puerto de emparejamiento que muestra el móvil: '
  IFS= read -r endpoint || return 1
  if ! valid_endpoint "$endpoint"; then
    err "Dirección no válida. Usa IP:puerto (ejemplo: 192.168.1.20:37123)."
    return 2
  fi
  info "Cuando ADB lo solicite, escribe el código de seis dígitos que muestra el teléfono."
  info "No se guardará el código en un archivo ni en el historial del shell."
  if ! adb pair "$endpoint"; then
    err "El emparejamiento falló."
    return 1
  fi
  ok "Emparejamiento completado."
  connect_after_pairing
}

show_menu() {
  local selected=0 key seq
  local -a labels=("Emparejar por QR" "Emparejar con código" "Ver dispositivos ADB" "Ayuda / requisitos" "Salir")
  while true; do
    printf '\033[2J\033[H'
    printf '%sADB%s  %s/  EMPAREJAMIENTO INALÁMBRICO%s\n\n' "$C_CYAN" "$C_RESET" "$C_DIM" "$C_RESET"
    printf '%sSelecciona una acción%s  ·  Ubuntu + Android\n\n' "$C_BOLD" "$C_RESET"
    local i
    for i in "${!labels[@]}"; do
      if (( i == selected )); then
        printf '  %s> %d) %-28s%s\n' "$C_GREEN" "$((i + 1))" "${labels[$i]}" "$C_RESET"
      else
        printf '    %d) %s\n' "$((i + 1))" "${labels[$i]}"
      fi
    done
    printf '\n%s↑/↓ mover  ·  Enter elegir  ·  1–5 acceso directo  ·  q salir%s\n' "$C_DIM" "$C_RESET"
    IFS= read -rsn1 key || return 0
    if [[ "$key" == $'\e' ]]; then
      seq=''
      IFS= read -rsn2 -t 0.15 seq || true
      case "$seq" in
        '[A') ((selected = (selected + ${#labels[@]} - 1) % ${#labels[@]})) ;;
        '[B') ((selected = (selected + 1) % ${#labels[@]})) ;;
      esac
      continue
    fi
    [[ "$key" == "q" || "$key" == "Q" ]] && return 0
    if [[ "$key" =~ ^[1-5]$ ]]; then selected=$((key - 1)); fi
    if [[ -z "$key" || "$key" =~ ^[1-5]$ ]]; then
      case "$selected" in
        0) pair_qr; printf '\nPulsa Enter para volver al menú…'; IFS= read -r _ || true ;;
        1) pair_code; printf '\nPulsa Enter para volver al menú…'; IFS= read -r _ || true ;;
        2) show_devices; printf '\nPulsa Enter para volver al menú…'; IFS= read -r _ || true ;;
        3) usage; printf '\nPulsa Enter para volver al menú…'; IFS= read -r _ || true ;;
        4) return 0 ;;
      esac
    fi
  done
}

main() {
  local mode='menu'
  while (($#)); do
    case "$1" in
      --help|-h) usage; return 0 ;;
      --version) printf '%s %s\n' "$APP_NAME" "$VERSION"; return 0 ;;
      --qr) mode='qr' ;;
      --code) mode='code' ;;
      --list) mode='list' ;;
      --timeout)
        shift
        if (($# == 0)) || [[ ! "$1" =~ ^[0-9]+$ ]]; then
          err "--timeout requiere segundos enteros entre 10 y 900."
          return 2
        fi
        TIMEOUT="$1"
        ;;
      *) err "Opción desconocida: $1"; usage >&2; return 2 ;;
    esac
    shift
  done
  case "$mode" in
    qr) pair_qr ;;
    code) pair_code ;;
    list) show_devices ;;
    menu)
      if [[ ! -t 0 ]]; then
        err "El menú requiere una terminal interactiva. Usa --qr, --code, --list o --help."
        return 2
      fi
      check_adb || return $?
      show_menu
      ;;
  esac
}

main "$@"
